          "blurNoise": 0.04,
          "blurPasses": 2,
          "blurPopups": true,
          "blurSize": 4,
          "blurSpecial": false,
          "blurVibrancy": 0.16,
          "blurVibrancyDarkness": 0,
          "blurXray": false,
          "borderAngleSpeed": 4,
